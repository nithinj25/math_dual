# Copy to .env on the server and fill in. The root .gitignore already ignores
# .env, so it cannot be committed by accident.
#
# Generate the password with:  openssl rand -base64 24

DOMAIN=yourname.duckdns.org
POSTGRES_PASSWORD=

# Public by design — Vite inlines these into the browser bundle.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Server-side JWT verification.
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
