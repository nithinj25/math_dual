# Vite only exposes vars prefixed VITE_, and inlines them at build time.
# The anon key is public by design — it is meant to ship in client code.
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your anon / public key>
VITE_GATEWAY_URL=ws://127.0.0.1:8080
VITE_API_URL=http://127.0.0.1:8000
